# ============================================================
# AEGIS AI — Containerized Environment Variables
# ============================================================

# Application Runtime Configuration
APP_NAME="AEGIS AI Enterprise Platform"
APP_ENV=production
DEBUG=false

# PostgreSQL + pgvector Database Container Connection
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_secure_pass_2026!
POSTGRES_DB=aegis_ai
DATABASE_URL=postgresql+asyncpg://aegis:aegis_secure_pass_2026!@db:5432/aegis_ai

# Security, Cryptography & JWT Token Parameters
JWT_SECRET_KEY=aegis_super_secure_jwt_secret_key_prod_2026_enterprise_hardening_docker!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost"]

# AI Providers & Model Configurations
DEFAULT_LLM_PROVIDER=mock
EMBEDDING_PROVIDER=local
GEMINI_API_KEY=AIzaSyCBdRc1p-_qq1lekeagJ7sLEuBl14Uj0UU

# Rate Limiting & Enterprise Hardening
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_CAPACITY=120
RATE_LIMIT_IP_REFILL_RATE=2.0
RATE_LIMIT_TENANT_CAPACITY=600
RATE_LIMIT_TENANT_REFILL_RATE=10.0

# Document Storage & Ingestion
FILE_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=25

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000
