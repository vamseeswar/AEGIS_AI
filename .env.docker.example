# ============================================================
# AEGIS AI — Containerized Environment Variables Template
# ============================================================

# Application Runtime Configuration
APP_NAME="AEGIS AI Enterprise Platform"
APP_ENV=production
DEBUG=false

# PostgreSQL + pgvector Database Container Connection
POSTGRES_USER=aegis
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=aegis_ai
DATABASE_URL=postgresql+asyncpg://aegis:your_secure_postgres_password_here@db:5432/aegis_ai

# Security, Cryptography & JWT Token Parameters
JWT_SECRET_KEY=generate_a_64_character_random_secret_key_here!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost"]

# AI Providers & Model Configurations
DEFAULT_LLM_PROVIDER=mock
EMBEDDING_PROVIDER=local
GEMINI_API_KEY=your_gemini_api_key_here

# Rate Limiting & Enterprise Hardening
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_CAPACITY=120
RATE_LIMIT_IP_REFILL_RATE=2.0
RATE_LIMIT_TENANT_CAPACITY=600
RATE_LIMIT_TENANT_REFILL_RATE=10.0

# Document Storage & Ingestion
FILE_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=25

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000
