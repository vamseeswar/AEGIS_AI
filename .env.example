# ============================================================
# AEGIS AI Environment Configuration
# Copy this file to .env and configure your values.
# NEVER commit .env with real secrets to version control.
# ============================================================

# Application Environment: development | staging | production | test
APP_ENV=development
APP_NAME="AEGIS AI"
API_V1_STR="/api/v1"
PORT=8000
HOST=0.0.0.0

# Cryptography & Security
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string
JWT_SECRET=change_this_to_another_secure_random_64_character_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL with pgvector)
# For local development, default postgres or sqlite fallback is supported
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aegis_ai
# Optional sync URL for migrations if needed
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/aegis_ai

# Cache & Message Queue (Redis optional)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# AI Model Providers
# LLM_PROVIDER: gemini | openai | local
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=your_gemini_api_key_here
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# OpenAI Compatible Fallback/Alternative
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Embeddings Configuration
# EMBEDDING_PROVIDER: gemini | openai | local (sentence-transformers)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Document Storage: local | s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./backend/storage

# Network & CORS (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting & Safety
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=25

# Observability
LOG_LEVEL=INFO
ENABLE_METRICS=true
